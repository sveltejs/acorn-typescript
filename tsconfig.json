{
	"compilerOptions": {
		"allowJs": false,
		"target": "es6",
		"allowSyntheticDefaultImports": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "lib",
		"experimentalDecorators": true,
		"lib": ["es2017", "dom"],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"preserveConstEnums": true,
		"removeComments": false,
		"sourceMap": true,
		"strict": false,
		"skipLibCheck": true
	},
	"include": ["./src/**/*", "./test/**/*"],
	"exclude": ["./test/*/input.ts"]
}
